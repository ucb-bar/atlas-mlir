// RUN: not atlas-opt --verify-atlas-timing %s -o /dev/null 2>&1 | FileCheck %s
// CHECK: conflict
// One change to cfg_dma_kit_prefetch.mlir: x24 = x19 makes DMA overwrite the current VLOAD/VSTORE window.
module {
  %s0 = "atlas.start"() : () -> !atlas.state loc("cfg_dma_kit_prefetch.S":0:0)
  %s1 = "atlas.alu_imm"(%s0) {kind = "addi", dst = 5 : i32, src = 0 : i32, immediate = 1024 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":6:1)
  %s2 = "atlas.upper"(%s1) {kind = "lui", dst = 8 : i32, immediate = 589824 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":7:1)
  %s3 = "atlas.upper"(%s2) {kind = "lui", dst = 15 : i32, immediate = 490 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":8:1)
  %s4 = "atlas.alu_imm"(%s3) {kind = "addi", dst = 19 : i32, src = 0 : i32, immediate = 0 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":9:1)
  %s5 = "atlas.alu_reg"(%s4) {kind = "add", dst = 20 : i32, lhs = 15 : i32, rhs = 0 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":10:1)
  %s6 = "atlas.alu_imm"(%s5) {kind = "addi", dst = 21 : i32, src = 0 : i32, immediate = 5 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":11:1)
  %s7 = "atlas.alu_reg"(%s6) {kind = "add", dst = 20 : i32, lhs = 20 : i32, rhs = 8 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":12:1)
  %s8 = "atlas.dma"(%s7) {direction = "load", channel = 0 : i32, reg = 19 : i32, dram = 20 : i32, size = 5 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":13:1)
  %s9 = "atlas.alu_reg"(%s8) {kind = "sub", dst = 20 : i32, lhs = 20 : i32, rhs = 8 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":14:1)
  %s10 = "atlas.dma_wait"(%s9) {channel = 0 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":15:1)
  %s11 = "atlas.alu_imm"(%s10) {kind = "addi", dst = 24 : i32, src = 19 : i32, immediate = 0 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":17:1)
  %s12 = "atlas.alu_imm"(%s11) {kind = "addi", dst = 20 : i32, src = 20 : i32, immediate = 1024 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":18:1)
  %s13 = "atlas.alu_imm"(%s12) {kind = "addi", dst = 21 : i32, src = 21 : i32, immediate = -1 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":19:1)
  %s14 = "atlas.branch"(%s13) {kind = "beq", lhs = 21 : i32, rhs = 0 : i32, offset_bytes = 30 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":20:1)
  %s15 = "atlas.alu_imm"(%s14) {kind = "addi", dst = 0 : i32, src = 0 : i32, immediate = 0 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":21:1)
  %s16 = "atlas.alu_reg"(%s15) {kind = "add", dst = 20 : i32, lhs = 20 : i32, rhs = 8 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":22:1)
  %s17 = "atlas.dma"(%s16) {direction = "load", channel = 1 : i32, reg = 24 : i32, dram = 20 : i32, size = 5 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":23:1)
  %s18 = "atlas.alu_reg"(%s17) {kind = "sub", dst = 20 : i32, lhs = 20 : i32, rhs = 8 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":24:1)
  %s19 = "atlas.vload"(%s18) {dst = 1 : i32, base = 19 : i32, offset = 0 : i32, format = "raw"} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":25:1)
  %s20 = "atlas.delay"(%s19) {cycles = 34 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":26:1)
  %s21 = "atlas.xlu_transpose"(%s20) {dst = 1 : i32, src = 1 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":27:1)
  %s22 = "atlas.delay"(%s21) {cycles = 66 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":28:1)
  %s23 = "atlas.vstore"(%s22) {src = 1 : i32, base = 19 : i32, offset = 0 : i32, format = "raw"} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":29:1)
  %s24 = "atlas.delay"(%s23) {cycles = 34 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":30:1)
  %s25 = "atlas.dma_wait"(%s24) {channel = 1 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":31:1)
  %s26 = "atlas.alu_reg"(%s25) {kind = "add", dst = 19 : i32, lhs = 24 : i32, rhs = 0 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":32:1)
  %s27 = "atlas.jump"(%s26) {kind = "jal", dst = 0 : i32, base = 0 : i32, offset = -32 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":33:1)
  %s28 = "atlas.alu_imm"(%s27) {kind = "addi", dst = 0 : i32, src = 0 : i32, immediate = 0 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":34:1)
  %s29 = "atlas.vload"(%s28) {dst = 1 : i32, base = 19 : i32, offset = 0 : i32, format = "raw"} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":36:1)
  %s30 = "atlas.delay"(%s29) {cycles = 34 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":37:1)
  %s31 = "atlas.xlu_transpose"(%s30) {dst = 1 : i32, src = 1 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":38:1)
  %s32 = "atlas.delay"(%s31) {cycles = 66 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":39:1)
  %s33 = "atlas.vstore"(%s32) {src = 1 : i32, base = 19 : i32, offset = 0 : i32, format = "raw"} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":40:1)
  %s34 = "atlas.delay"(%s33) {cycles = 34 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":41:1)
  %s35 = "atlas.alu_imm"(%s34) {kind = "addi", dst = 0 : i32, src = 0 : i32, immediate = 0 : i32} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":42:1)
  %s36 = "atlas.trap"(%s35) {kind = "ecall"} : (!atlas.state) -> !atlas.state loc("cfg_dma_kit_prefetch.S":43:1)
}
